---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Picture from '../components/Picture.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { ROUTES, type Lang } from '../data/routes';
import { UI } from '../data/ui';
import { SITE } from '../data/site';
import { breadcrumbLd } from '../lib/seo';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = UI[lang];
const L = 'https://www.pointspace.ca';
// Roles and blurbs as published on the live careers pages; postings stay on the live site.
const T = {
  fr: {
    title: 'Carrières chez pointSpace | pointSpace',
    description: "Emplois chez pointSpace : chargé de projet, technicien Revit (nuage de points et scan 3D) et stage en marketing numérique. Rejoignez l'équipe.",
    h1: 'Carrières', lead: "Commencez une nouvelle aventure : nous souhaitons élargir notre équipe de partenaires clés.",
    introTitle: "Rejoignez l'équipe",
    intro: "Tout grand projet commence par des personnes formidables. Nous sommes toujours à la recherche de personnes motivées qui souhaitent évoluer avec nous. Vous pensez être la personne idéale ? N'hésitez pas à nous contacter.",
    jobsTitle: 'Postes ouverts',
    jobs: [
      { h: 'Chargé(e) de projet', p: "Guidez les projets du début à la fin, générez un impact tangible et évoluez aux côtés d'une équipe collaborative.", url: `${L}/fr-ca/carrieres/charge-projet` },
      { h: 'Technicien(ne) Revit (nuages de points / scan 3D)', p: 'Transformez le travail de terrain en informations utiles, générez un impact tangible et développez votre expertise.', url: `${L}/fr-ca/carrieres/technicien-releve-batiment` },
      { h: 'Stage en marketing numérique', p: 'Acquérez une expérience pratique, donnez vie à vos idées et développez des compétences durables.', url: `${L}/fr-ca/carrieres/stagiaire-marketing` },
    ],
    view: "Voir l'offre", spontaneousTitle: 'Vous cherchez quelque chose de différent ?', spontaneous: 'Envoyez-nous une candidature spontanée.', write: 'Écrire à Louis Dallaire',
  },
  en: {
    title: 'Careers at pointSpace | pointSpace',
    description: 'Jobs at pointSpace: project manager, Revit technician (point cloud and 3D scan) and digital marketing internship. Join the team.',
    h1: 'Careers', lead: 'Start a new adventure: we aim to expand our team of key partners.',
    introTitle: 'Join the team',
    intro: 'Every great project starts with great people. We’re always looking for motivated, driven people who want to grow with us. Think you’d be a great fit? We’d love to hear from you.',
    jobsTitle: 'Open positions',
    jobs: [
      { h: 'Project manager', p: 'Guide projects from start to finish, make a tangible impact and grow alongside a collaborative team.', url: `${L}/careers/project-manager` },
      { h: 'Revit technician (point cloud / 3D scan)', p: 'Turn fieldwork into meaningful insights, make a tangible impact and grow your expertise.', url: `${L}/careers/technician-building-survey` },
      { h: 'Digital marketing intern', p: 'Gain hands-on experience, bring your ideas to life and build lasting skills.', url: `${L}/careers/marketing-intern` },
    ],
    view: 'View posting', spontaneousTitle: 'Looking for something different?', spontaneous: 'Send us a spontaneous application.', write: 'Write to Louis Dallaire',
  },
}[lang];
const crumbs = [{ name: t.home, path: ROUTES.home[lang] }, { name: T.h1, path: ROUTES.careers[lang] }];
---
<BaseLayout lang={lang} route="careers" title={T.title} description={T.description} jsonLd={[breadcrumbLd(crumbs.map((c) => ({ name: c.name, path: c.path })))]}>
  <PageHero lang={lang} crumbs={crumbs} h1={T.h1} lead={T.lead} image="equipement-releve-pointspace" position="50% 50%" />

  <section class="section theme-cream" aria-labelledby="intro-title">
    <div class="container intro">
      <div>
        <h2 id="intro-title" class="t-h2">{T.introTitle}</h2>
        <p class="t-lead t-muted">{T.intro}</p>
      </div>
      <Picture name="technicien-releve-numerisation-usine" lang={lang} ratio="4/5" sizes="(min-width:1280px) 35vw" position="50% 30%" />
    </div>
  </section>

  <section class="section theme-cream-50" aria-labelledby="jobs-title">
    <div class="container">
      <SectionHeading eyebrow={t.careers} title={T.jobsTitle} id="jobs-title" />
      <ul class="jobs">
        {T.jobs.map((j) => (
          <li class="job is-card" data-reveal>
            <h3 class="t-h3"><a class="job__link card-link" href={j.url}>{j.h}</a></h3>
            <p class="t-muted">{j.p}</p>
            <span class="t-small job__cta">{T.view} <span class="t-muted">{t.liveLink}</span> <span class="go go--ext" aria-hidden="true">↗</span></span>
          </li>
        ))}
      </ul>
      <div class="spont">
        <div><h3 class="t-h3">{T.spontaneousTitle}</h3><p class="t-muted">{T.spontaneous}</p></div>
        <a class="btn btn--secondary" href={`mailto:${SITE.email}`}>{T.write}<span class="btn__arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro { display: grid; grid-template-columns: 1.3fr 1fr; gap: var(--sp-9); align-items: center; }
  .intro h2 { margin-bottom: var(--sp-5); }
  .jobs { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-6); }
  .job { position: relative; display: flex; flex-direction: column; gap: 12px; padding: var(--sp-6); background: var(--ps-cream); border: 1px solid var(--line); border-radius: var(--radius-card); transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
  .job:hover { border-color: var(--ps-green-900); transform: var(--hover-lift); box-shadow: var(--hover-shadow); }
  .job:hover .job__link { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  .job__link { text-decoration: none; }
  .job__link::after { content: ''; position: absolute; inset: 0; }
  .job__cta { margin-top: auto; font-weight: 500; }
  .spont { display: flex; justify-content: space-between; align-items: center; gap: var(--sp-6); margin-top: var(--sp-8); padding-top: var(--sp-6); border-top: 1px solid var(--line); }
</style>
