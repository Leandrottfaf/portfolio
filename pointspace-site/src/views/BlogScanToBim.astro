---
// Blog article on Thierry's blog structure (H1, intro, H2 sections, FAQ, conclusion).
// Topic: 3D scanning, Scan to BIM and as-built drawings are one chain, and pointSpace
// delivers all of it. The film from ../bim-to-cad shows that chain in the "use case"
// section: the live film (public/film/, see scripts/sync-film.mjs), driven by scrolling.
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Picture from '../components/Picture.astro';
import Faq from '../components/Faq.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { ROUTES, type Lang } from '../data/routes';
import { UI } from '../data/ui';
import { serviceById } from '../data/services';
import { image } from '../data/images';
import { breadcrumbLd, faqLd, absUrl } from '../lib/seo';
import { SITE } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = UI[lang];

const T = {
  fr: {
    title: 'Scan 3D, Scan to BIM ou plans as-built : lequel choisir ? | pointSpace',
    description: "Scan 3D, Scan to BIM, plans tels que construits : trois services qui se ressemblent, trois livrables différents. Comment ils s'enchaînent, et lequel commander.",
    crumb: 'Scan 3D, Scan to BIM ou plans tels que construits',
    eyebrow: "Blogue · Relevé de l'existant",
    h1: 'Numérisation 3D, Scan to BIM ou plans tels que construits : quelle différence, et lequel choisir ?',
    lead: 'Vous préparez une rénovation et la soumission parle de scan 3D, de Scan to BIM et de plans tels que construits, les fameux plans as-built. Trois termes qui se ressemblent, trois livrables bien différents.',
    intro: "Commander le mauvais coûte cher : un modèle Revit dont personne ne se sert, ou des plans 2D alors que vos ingénieurs avaient besoin d'une maquette pour coordonner. Dans cet article, on explique ce que chaque service produit, comment ils s'enchaînent et comment choisir ce dont votre projet a vraiment besoin.",
    date: '8 octobre 2026', read: '7 min de lecture', by: 'Par',
    chips: ['Numérisation LiDAR 3D', 'Scan to BIM', 'Plans tels que construits'],
    toc: 'Dans cet article',
    why: {
      h: 'Pourquoi ce besoin est important',
      p: [
        "Sur papier, un bâtiment ne bouge pas. Dans la réalité, il change tout le temps : une cloison ajoutée dans les années 90, une porte condamnée, une dalle qui n'est plus tout à fait de niveau. Les plans d'origine, quand on les retrouve, racontent rarement l'état actuel des lieux.",
        "C'est pour ça qu'un projet sur un bâtiment existant commence presque toujours par un relevé de l'existant. La vraie question, c'est la forme qu'il doit prendre. Et c'est là que les trois termes se mélangent, alors qu'ils ne désignent pas trois options concurrentes : ce sont trois étapes d'une même chaîne.",
      ],
      defsTitle: 'En une phrase',
      defs: [
        ['La numérisation 3D (le scan 3D)', "mesure le bâtiment. Le scanner laser capte des millions de points : c'est le nuage de points."],
        ['Le Scan to BIM', 'reconstruit le bâtiment. Murs, dalles, toiture et ouvertures sont modélisés dans Revit, directement sur le nuage de points.'],
        ['Les plans tels que construits (plans as-built)', "le mettent sur papier. Plans d'étage, élévations et coupes en DWG et en PDF, tirés du nuage de points ou du modèle."],
      ],
    },
    how: {
      h: 'Comment pointSpace répond à ce besoin',
      p: "Chez pointSpace, la même équipe s'occupe de tout, du relevé sur place jusqu'aux plans livrés. On ne fait pas seulement de la 3D, ni seulement du 2D. Les données ne changent jamais de mains entre deux fournisseurs, et la personne qui dessine peut toujours retourner au nuage de points pour vérifier.",
      steps: [
        { h: "Comprendre l'usage", p: "Avant de parler de formats, on vous demande ce que vous allez faire des données : concevoir, coordonner, louer, entretenir. C'est ce qui fixe les livrables et le niveau de détail (LOD)." },
        { h: 'Numériser sur place', p: "Un technicien fait le relevé laser de l'intérieur et de l'extérieur au scanner Leica, en multipliant les positions pour ne laisser aucune zone d'ombre.", link: { label: 'Le processus de numérisation, en détail', href: 'https://www.pointspace.ca/fr-ca/la-numerisation-3d-le-processus-de-numerisation' } },
        { h: 'Assembler le nuage de points', p: 'Les scans sont alignés dans un même système de coordonnées, nettoyés, puis vérifiés.' },
        { h: 'Modéliser dans Revit', p: 'Quand le projet le demande, on modélise le bâtiment sur le nuage de points, au niveau de détail convenu.', link: { label: 'Le processus de modélisation et de mise en plan', href: 'https://www.pointspace.ca/fr-ca/la-numerisation-3d-le-processus-de-modelisation3d-et-mise-en-plan' } },
        { h: 'Mettre en plan et contrôler', p: 'Plans, élévations et coupes sont dessinés dans AutoCAD ou tirés du modèle, puis comparés au nuage de points avant la livraison.' },
      ],
    },
    deliv: {
      h: 'Quels livrables peuvent être fournis',
      p: "Un seul relevé peut alimenter plusieurs livrables, et vous pouvez vous arrêter à n'importe quelle étape.",
      items: [
        { h: 'Nuage de points', p: 'Le relevé complet, mesurable dans votre logiciel. Formats E57 et RCP/RCS.', img: 'blogue-chaine-nuage-points' },
        { h: 'Modèle BIM', p: 'Maquette Revit (RVT) ou IFC, au niveau de détail convenu, prête pour la coordination.', img: 'blogue-chaine-modele-revit' },
        { h: 'Élévations et coupes', p: "Façades et coupes cotées, cohérentes entre elles parce qu'elles viennent du même modèle.", img: 'blogue-chaine-elevation' },
        { h: "Plans d'étage", p: 'Plans tels que construits en DWG et en PDF, prêts à annoter.', img: 'blogue-chaine-plan-etage' },
      ],
      note: 'Aussi sur demande : photos 360°, visites virtuelles Matterport, modèles 3D en STEP ou SAT.',
    },
    types: {
      h: 'Pour quels types de projets ou bâtiments',
      p: 'Le bon livrable dépend moins du bâtiment que de ce que vous allez en faire. Quelques repères :',
      head: ['Votre projet', 'Par où commencer'],
      rows: [
        { a: "Réaménager un étage de bureaux ou un commerce", b: 'Plans tels que construits (DWG)', href: ROUTES.asBuilt.fr },
        { a: 'Rénover ou agrandir un bâtiment, avec architecte et ingénieurs', b: 'Modèle Revit, et les plans tirés du modèle', href: ROUTES.scanToBim.fr },
        { a: "Ajouter une machine ou revoir l'aménagement d'une usine", b: "Nuage de points, puis plans 2D ou 3D de l'aire visée", href: ROUTES.manufacturing.fr },
        { a: 'Restaurer une façade ou un bâtiment patrimonial', b: 'Nuage de points et élévations détaillées', href: ROUTES.caseWindsor.fr },
        { a: 'Louer ou gérer des superficies commerciales', b: 'Plans de mesurage BOMA', href: ROUTES.boma.fr },
      ],
      after: "Pas certain ? Décrivez-nous le projet : on vous dira ce qui vous sera utile, et ce qui ne l'est pas.",
    },
    benef: {
      h: 'Quels bénéfices pour les équipes',
      items: [
        { h: 'Architectes', p: "Une base fiable dès l'esquisse, et des élévations qui correspondent vraiment au bâtiment." },
        { h: 'Ingénieurs', p: 'La géométrie réelle pour coordonner la structure et la mécanique, et repérer les conflits avant le chantier.' },
        { h: 'Propriétaires et gestionnaires', p: "Une documentation à jour de l'actif, réutilisable pour chaque projet qui suivra." },
        { h: 'Entrepreneurs', p: 'Moins de visites de vérification, moins de reprises et des soumissions plus justes.' },
      ],
    },
    example: {
      eyebrow: "Cas d'usage",
      h: 'Une visite sur place, tous les livrables',
      p: "Le même bâtiment passe par les trois étapes. Le nuage de points apparaît d'abord, le modèle Revit se construit par-dessus, puis la vue s'aplatit pour devenir l'élévation AutoCAD, suivie de la coupe et du plan d'étage. Un relevé, un modèle et des plans, tous issus des mêmes mesures.",
      hint: 'Faites défiler pour avancer, remontez pour revenir.',
      steps: [
        { h: 'Le relevé', p: 'Le nuage de points : chaque surface visible, mesurée sur place.' },
        { h: 'Le modèle', p: 'La maquette Revit, construite directement sur le nuage de points.' },
        { h: 'Les plans', p: "Élévation, coupe et plan d'étage tirés du modèle, livrés en DWG et en PDF." },
      ],
      videoLabel: "Film : un bâtiment passe du nuage de points au modèle Revit, puis aux plans AutoCAD.",
      
    },
    faq: {
      h: 'FAQ',
      items: [
        { q: 'Peut-on commander seulement les plans, sans modèle Revit ?', a: "Oui. Pour un réaménagement intérieur, des plans tels que construits dessinés directement à partir du nuage de points suffisent souvent. Le modèle devient utile quand plusieurs vues doivent rester cohérentes entre elles, ou quand plusieurs disciplines travaillent sur le même bâtiment." },
        { q: 'Si on commence avec des plans 2D, peut-on ajouter un modèle BIM plus tard ?', a: "Oui. On conserve le nuage de points : le modèle peut être produit des mois plus tard à partir du même relevé, sans retourner sur place, tant que le bâtiment n'a pas changé." },
        { q: 'Comment savez-vous que les plans correspondent au bâtiment ?', a: "Chaque livrable est comparé au nuage de points avant la livraison. Et comme les plans et le modèle viennent des mêmes mesures, une élévation et une coupe ne peuvent pas se contredire." },
        { q: "Qu'est-ce que le niveau de détail (LOD), et lequel choisir ?", a: "Le LOD fixe ce qui est modélisé, et avec quelle précision : les murs et les ouvertures seulement, ou aussi les moulures, la mécanique et le mobilier. On le choisit ensemble selon l'usage du modèle. Plus de détail coûte plus cher, et n'est utile que si quelqu'un s'en sert." },
      ],
    },
    concl: {
      h: 'Conclusion',
      p: "La numérisation 3D, le Scan to BIM et les plans tels que construits ne sont pas trois services à comparer, mais trois étapes d'un même relevé. La seule vraie question, c'est où s'arrêter, et ça dépend de ce que vous ferez des données. Dites-nous ce que vous allez faire des plans : on vous dira quoi commander.",
    },
    author: 'Rédigé par Leandro Lazaretti, technicien Revit (du nuage de points au BIM) chez pointSpace.',
    servicesTitle: 'Services liés',
    ctaTitle: 'Pas certain du livrable qu’il vous faut ?',
    ctaText: 'Décrivez le bâtiment et ce que vous voulez en faire. On vous recommande les bons livrables et on vous prépare une soumission.',
  },
  en: {
    title: '3D Scanning, Scan to BIM or As-Built Drawings? | pointSpace',
    description: '3D scanning, Scan to BIM and as-built drawings sound alike but deliver different things. How they connect, and which one to order for your project.',
    crumb: '3D scanning, Scan to BIM or as-built drawings',
    eyebrow: 'Blog · Existing conditions',
    h1: "3D Scanning, Scan to BIM or As-Built Drawings: What's the Difference, and Which One Do You Need?",
    lead: "You're planning a renovation, and the quote mentions 3D scanning, Scan to BIM and as-built drawings. Three terms that sound alike, and three very different deliverables.",
    intro: "Ordering the wrong one is expensive: a Revit model nobody opens, or 2D drawings when your engineers needed a model to coordinate. This article explains what each service produces, how they connect, and how to pick what your project actually needs.",
    date: 'October 8, 2026', read: '7 min read', by: 'By',
    chips: ['LiDAR 3D scanning', 'Scan to BIM', 'As-built drawings'],
    toc: 'In this article',
    why: {
      h: 'Why this need matters',
      p: [
        "On paper, a building never moves. In real life it changes all the time: a partition added in the '90s, a door closed off, a slab that's no longer quite level. The original drawings, when anyone can find them, rarely describe the building as it stands today.",
        "That's why work on an existing building almost always starts with an existing conditions survey. The real question is what form it should take, and that's where the three terms get mixed up. They aren't three competing options. They're three stages of the same chain.",
      ],
      defsTitle: 'In one sentence',
      defs: [
        ['3D scanning', 'measures the building. The laser scanner captures millions of points: the point cloud.'],
        ['Scan to BIM (point cloud to BIM)', 'rebuilds the building. Walls, slabs, roof and openings are modeled in Revit, right on the point cloud.'],
        ['As-built drawings (as-built plans)', 'put it on paper. Floor plans, elevations and sections in DWG and PDF, taken from the point cloud or the model.'],
      ],
    },
    how: {
      h: 'How pointSpace addresses this need',
      p: "At pointSpace, one team handles everything, from the site visit to the drawings you receive. We don't only do 3D, and we don't only do 2D. The data never passes between two suppliers, and whoever drafts your plans can always go back to the point cloud to check.",
      steps: [
        { h: 'Understand the use', p: "Before we talk formats, we ask what you'll do with the data: design, coordinate, lease, maintain. That's what sets the deliverables and the level of development (LOD)." },
        { h: 'Scan on site', p: 'A technician surveys the inside and outside with a Leica laser scanner, from as many positions as it takes to leave no blind spots.', link: { label: 'The 3D scanning process, in detail', href: 'https://www.pointspace.ca/3d-scanning-the-scanning-process' } },
        { h: 'Register the point cloud', p: 'The scans are aligned in one coordinate system, cleaned, then checked.' },
        { h: 'Model in Revit', p: 'When the project calls for it, we model the building on the point cloud, to the agreed level of development.', link: { label: 'The 3D modeling process', href: 'https://www.pointspace.ca/3d-modeling-process' } },
        { h: 'Draft and check', p: 'Plans, elevations and sections are drafted in AutoCAD or taken from the model, then compared with the point cloud before delivery.' },
      ],
    },
    deliv: {
      h: 'What deliverables can be provided',
      p: 'One survey can feed several deliverables, and you can stop at any stage.',
      items: [
        { h: 'Point cloud', p: 'The complete survey, measurable in your own software. E57 and RCP/RCS formats.', img: 'blogue-chaine-nuage-points' },
        { h: 'BIM model', p: 'Revit (RVT) or IFC model, to the agreed level of development, ready for coordination.', img: 'blogue-chaine-modele-revit' },
        { h: 'Elevations and sections', p: 'Dimensioned façades and sections that agree with each other, because they come from the same model.', img: 'blogue-chaine-elevation' },
        { h: 'Floor plans', p: 'As-built drawings in DWG and PDF, ready to mark up.', img: 'blogue-chaine-plan-etage' },
      ],
      note: 'Also on request: 360° photos, Matterport virtual tours, 3D models in STEP or SAT.',
    },
    types: {
      h: 'What types of projects or buildings this applies to',
      p: "The right deliverable depends less on the building than on what you'll do with it. A few pointers:",
      head: ['Your project', 'Where to start'],
      rows: [
        { a: 'Refitting an office floor or a store', b: 'As-built drawings (DWG)', href: ROUTES.asBuilt.en },
        { a: 'Renovating or extending a building, with an architect and engineers', b: 'Revit model, and drawings taken from it', href: ROUTES.scanToBim.en },
        { a: 'Adding a machine or rethinking a plant layout', b: 'Point cloud, then 2D or 3D drawings of the area', href: ROUTES.manufacturing.en },
        { a: 'Restoring a façade or a heritage building', b: 'Point cloud and detailed elevations', href: ROUTES.caseWindsor.en },
        { a: 'Leasing or managing commercial space', b: 'BOMA measurement plans', href: ROUTES.boma.en },
      ],
      after: "Not sure? Tell us about the project, and we'll tell you what will be useful and what won't.",
    },
    benef: {
      h: 'What benefits this brings to project teams',
      items: [
        { h: 'Architects', p: 'A reliable base from the first sketch, and elevations that actually match the building.' },
        { h: 'Engineers', p: 'The real geometry to coordinate structure and mechanical systems, and catch clashes before construction.' },
        { h: 'Owners and property managers', p: 'Up-to-date documentation of the asset, reusable for every project that follows.' },
        { h: 'Contractors', p: 'Fewer verification visits, less rework and more accurate bids.' },
      ],
    },
    example: {
      eyebrow: 'Use case',
      h: 'One site visit, every deliverable',
      p: 'The same building goes through all three stages. The point cloud appears first, the Revit model is built over it, then the view flattens into the AutoCAD elevation, followed by the section and the floor plan. One survey, one model and a set of drawings, all from the same measurements.',
      hint: 'Scroll down to move forward, scroll up to go back.',
      steps: [
        { h: 'The survey', p: 'The point cloud: every visible surface, measured on site.' },
        { h: 'The model', p: 'The Revit model, built right on the point cloud.' },
        { h: 'The drawings', p: 'Elevation, section and floor plan taken from the model, delivered in DWG and PDF.' },
      ],
      videoLabel: 'Film: a building goes from point cloud to Revit model, then to AutoCAD drawings.',
      
    },
    faq: {
      h: 'FAQ',
      items: [
        { q: 'Can we order only the drawings, without a Revit model?', a: "Yes. For an interior refit, as-built drawings drafted straight from the point cloud are often enough. A model becomes useful when several views have to stay consistent with each other, or when several disciplines work on the same building." },
        { q: 'If we start with 2D drawings, can we add a BIM model later?', a: "Yes. We keep the point cloud, so the model can be produced months later from the same survey, without going back on site, as long as the building hasn't changed." },
        { q: 'How do you know the drawings match the building?', a: 'Every deliverable is compared with the point cloud before delivery. And because the drawings and the model come from the same measurements, an elevation and a section can’t contradict each other.' },
        { q: 'What is the level of development (LOD), and which one should we choose?', a: "The LOD sets what gets modeled, and how precisely: only walls and openings, or also mouldings, mechanical systems and furniture. We choose it together based on how the model will be used. More detail costs more, and it's only worth it if someone uses it." },
      ],
    },
    concl: {
      h: 'Conclusion',
      p: "3D scanning, Scan to BIM and as-built drawings aren't three services to compare. They're three stages of the same survey. The only real question is where to stop, and that depends on what you'll do with the data. Tell us what you'll do with the drawings, and we'll tell you what to order.",
    },
    author: 'Written by Leandro Lazaretti, Revit technician (point cloud to BIM) at pointSpace.',
    servicesTitle: 'Related services',
    ctaTitle: 'Not sure which deliverable you need?',
    ctaText: "Describe the building and what you want to do with it. We'll recommend the right deliverables and prepare a quote.",
  },
}[lang];

const sections = [
  ['pourquoi', T.why.h], ['comment', T.how.h], ['livrables', T.deliv.h], ['projets', T.types.h],
  ['benefices', T.benef.h], ['exemple', T.example.h], ['faq', T.faq.h], ['conclusion', T.concl.h],
] as const;
const crumbs = [
  { name: t.home, path: ROUTES.home[lang] },
  { name: t.blog, path: ROUTES.blog[lang] },
  { name: T.crumb, path: ROUTES.blogScanToBim[lang] },
];
const cover = image('blogue-chaine-couverture', lang);
const ogImage = '/images/blogue-chaine-couverture-1600.webp';
const FILM_END = 25.2; // film time (s) reached at the bottom of the scroll section: the three drawings side by side
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: T.h1, description: T.description, inLanguage: lang === 'fr' ? 'fr-CA' : 'en-CA',
    datePublished: '2026-10-08', author: { '@type': 'Person', name: 'Leandro Lazaretti' }, publisher: { '@id': `${SITE.url}/#organization` },
    image: absUrl(ogImage), mainEntityOfPage: absUrl(ROUTES.blogScanToBim[lang]) },
  faqLd(T.faq.items),
  breadcrumbLd(crumbs.map((c) => ({ name: c.name, path: c.path }))),
];
---
<BaseLayout lang={lang} route="blogScanToBim" title={T.title} description={T.description} jsonLd={jsonLd} ogImage={ogImage}>
  <header class="ahead theme-cream" aria-labelledby="h1">
    <div class="container">
      <Breadcrumbs lang={lang} items={crumbs} />
      <p class="eyebrow t-label ahead__eyebrow">{T.eyebrow}</p>
      <h1 id="h1" class="t-h1 ahead__h1">{T.h1}</h1>
      <div class="ahead__grid">
        <div>
          <p class="t-lead ahead__lead">{T.lead}</p>
          <p class="ahead__intro">{T.intro}</p>
        </div>
        <div class="ahead__meta">
          <p class="t-small"><time datetime="2026-10-08">{T.date}</time> · {T.read}</p>
          <p class="t-small">{T.by} Leandro Lazaretti</p>
          <ul class="chips">{T.chips.map((c) => <li class="chip">{c}</li>)}</ul>
        </div>
      </div>
    </div>
  </header>

  <div class="theme-cream">
    <div class="container grid-12 abody">
      <nav class="toc" aria-labelledby="toc-title">
        <p id="toc-title" class="t-label toc__h">{T.toc}</p>
        <ol>{sections.map(([id, h], i) => <li><a href={`#${id}`} data-toc={id}><span class="t-num">{String(i + 1).padStart(2, '0')}</span>{h}</a></li>)}</ol>
      </nav>

      <article class="acontent">
        <section id="pourquoi" class="asec" aria-labelledby="pourquoi-h">
          <h2 id="pourquoi-h" class="t-h3">{T.why.h}</h2>
          <div class="prose">{T.why.p.map((p) => <p>{p}</p>)}</div>
          <div class="defs">
            <p class="t-label defs__h">{T.why.defsTitle}</p>
            <dl>{T.why.defs.map(([term, d], i) => <div><dt><span class="t-num">{String(i + 1).padStart(2, '0')}</span>{term}</dt><dd>{d}</dd></div>)}</dl>
          </div>
        </section>

        <section id="comment" class="asec" aria-labelledby="comment-h">
          <h2 id="comment-h" class="t-h3">{T.how.h}</h2>
          <p class="prose">{T.how.p}</p>
          <ol class="steps">
            {T.how.steps.map((s, i) => (
              <li><span class="t-label t-num steps__n">{String(i + 1).padStart(2, '0')}</span><div><h3 class="t-h4">{s.h}</h3><p class="t-muted">{s.p}</p>{s.link && <a class="link-arrow t-small steps__link" href={s.link.href}>{s.link.label} <span aria-hidden="true">→</span></a>}</div></li>
            ))}
          </ol>
        </section>

        <section id="livrables" class="asec" aria-labelledby="livrables-h">
          <h2 id="livrables-h" class="t-h3">{T.deliv.h}</h2>
          <p class="prose">{T.deliv.p}</p>
          <ul class="deliv">
            {T.deliv.items.map((d) => (
              <li>
                <Picture name={d.img} lang={lang} ratio="2266/1104" sizes="(min-width:1280px) 28vw" />
                <h3 class="t-h4">{d.h}</h3>
                <p class="t-muted">{d.p}</p>
              </li>
            ))}
          </ul>
          <p class="t-small t-muted">{T.deliv.note}</p>
        </section>

        <section id="projets" class="asec" aria-labelledby="projets-h">
          <h2 id="projets-h" class="t-h3">{T.types.h}</h2>
          <p class="prose">{T.types.p}</p>
          <table class="pick">
            <thead><tr><th scope="col" class="t-label">{T.types.head[0]}</th><th scope="col" class="t-label">{T.types.head[1]}</th></tr></thead>
            <tbody>{T.types.rows.map((r) => <tr><td>{r.a}</td><td><a class="link-arrow" href={r.href}>{r.b} <span aria-hidden="true">→</span></a></td></tr>)}</tbody>
          </table>
          <p class="t-muted pick__after">{T.types.after}</p>
        </section>

        <section id="benefices" class="asec asec--last" aria-labelledby="benefices-h">
          <h2 id="benefices-h" class="t-h3">{T.benef.h}</h2>
          <ul class="benef">{T.benef.items.map((b) => <li><h3 class="t-h4">{b.h}</h3><p class="t-muted">{b.p}</p></li>)}</ul>
        </section>
      </article>
    </div>
  </div>

  {/* Use case: the scroll-driven film. The section is tall, the stage sticks, and the scroll position sets the film's time. */}
    <section id="exemple" class="scrub" data-scrub aria-labelledby="exemple-h">
