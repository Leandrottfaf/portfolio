<script>
  // Scroll-scrubbed video. Down = forward (point cloud → BIM model), up = backward.
  const root = document.querySelector<HTMLElement>('[data-scrub]');
  const video = root?.querySelector<HTMLVideoElement>('[data-scrub-video]');
  if (root && video) {
    const bar = root.querySelector<HTMLElement>('[data-scrub-bar]')!;
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const STEP_AT = [0, 0.33, 0.62]; // where each caption takes over (matches the animation's phases)
    let target = 0, current = 0, raf = 0, want = -1;

    const progress = () => {
      const r = root.getBoundingClientRect();
      const total = r.height - window.innerHeight;
      return total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 0;
    };
    const seek = () => {
      if (!video.duration || want < 0) return;
      const t = want * (video.duration - 0.05);
      if (!video.seeking && Math.abs(video.currentTime - t) > 0.015) video.currentTime = t;
    };
    const render = () => {
      want = current;
      seek();
      bar.style.transform = `scaleX(${current})`;
      let idx = 0;
      STEP_AT.forEach((at, i) => { if (current >= at) idx = i; });
      steps.forEach((s, i) => s.classList.toggle('is-active', i === idx));
    };
    const tick = () => {
      raf = 0;
      current = reduce ? target : current + (target - current) * 0.2;
      if (Math.abs(target - current) < 0.0008) current = target;
      render();
      if (current !== target) raf = requestAnimationFrame(tick);
    };
    const onScroll = () => { target = progress(); if (!raf) raf = requestAnimationFrame(tick); };

    video.addEventListener('seeked', seek);
    video.addEventListener('loadedmetadata', () => { root.classList.add('is-ready'); onScroll(); });
    if (video.readyState >= 1) root.classList.add('is-ready');
    video.pause();
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    onScroll();
  }

  // Table of contents: highlight the section being read.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')].map((a) => [a.dataset.toc!, a]));
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      links.forEach((a) => a.removeAttribute('aria-current'));
      links.get(e.target.id)?.setAttribute('aria-current', 'true');
    });
  }, { rootMargin: '-35% 0px -60% 0px' });
  links.forEach((_, id) => { const el = document.getElementById(id); if (el) io.observe(el); });
</script>

