<script define:vars={{ FILM_END }}>
  // Scroll-driven film. Down = forward (scan → model → drawings),
  // up = backward. The film page is same-origin, so its render(t) is called directly.
  const root = document.querySelector('[data-scrub]');
  const frame = root?.querySelector('[data-scrub-film]');
  if (root && frame) {
    const bar = root.querySelector('[data-scrub-bar]');
    const steps = [...root.querySelectorAll('[data-step]')];
    const STEP_AT = [0, 6.2, 13]; // film times where each caption takes over (scan, model, drawings)
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches; // no easing: jump to the scroll position
    let target = 0, current = 0, raf = 0;
    const film = () => frame.contentWindow?.film;

    const progress = () => {
      const r = root.getBoundingClientRect();
      const total = r.height - window.innerHeight;
      return total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 0;
    };
    const draw = () => {
      const t = current * FILM_END;
      film()?.render(t);
      bar.style.transform = `scaleX(${current})`;
      let idx = 0;
      STEP_AT.forEach((at, i) => { if (t >= at) idx = i; });
      steps.forEach((s, i) => s.classList.toggle('is-active', i === idx));
    };
    const tick = () => {
      raf = 0;
      current = reduce ? target : current + (target - current) * 0.18;
      if (Math.abs(target - current) < 0.0005) current = target;
      draw();
      if (current !== target) raf = requestAnimationFrame(tick);
    };
    const onScroll = () => { target = progress(); if (!raf) raf = requestAnimationFrame(tick); };

    // The film loads in the frame (model, scan and drawings); show it once it can draw.
    const ready = () => {
      if (film()?.ready) { root.classList.add('is-ready'); draw(); } else setTimeout(ready, 150);
    };
    frame.addEventListener('load', ready);
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    onScroll();
  }

  // Table of contents: highlight the section being read.
  const links = new Map([...document.querySelectorAll('[data-toc]')].map((a) => [a.dataset.toc, a]));
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      links.forEach((a) => a.removeAttribute('aria-current'));
      links.get(e.target.id)?.setAttribute('aria-current', 'true');
    });
  }, { rootMargin: '-35% 0px -60% 0px' });
  links.forEach((_, id) => { const el = document.getElementById(id); if (el) io.observe(el); });
</script>

