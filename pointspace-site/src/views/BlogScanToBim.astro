---
// Blog article built on Thierry's blog structure (H1, intro, 7 H2 sections, FAQ, conclusion).
// Model article for the marketing team: project facts not yet confirmed are highlighted with <mark class="todo">.
// The scroll section scrubs public/video/blog-scan-to-bim-scroll.mp4 (keyframe every 4 frames, so seeking stays smooth):
// scrolling down builds the BIM model, scrolling up takes it back to the point cloud.
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Picture from '../components/Picture.astro';
import Faq from '../components/Faq.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { ROUTES, type Lang } from '../data/routes';
import { UI } from '../data/ui';
import { serviceById } from '../data/services';
import { image } from '../data/images';
import { breadcrumbLd, faqLd, absUrl } from '../lib/seo';
import { SITE } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = UI[lang];
const TODO = null; // a fact still to confirm: rendered as a highlighted mark

const T = {
  fr: {
    title: "Scan 3D d'un bâtiment existant : plans et modèle BIM | pointSpace",
    description: "Du scan 3D au nuage de points, puis au modèle BIM, aux élévations et aux plans tels que construits : comment pointSpace documente un bâtiment existant.",
    crumb: "Scan 3D d'un bâtiment existant",
    draft: "Article modèle pour l'équipe marketing : les éléments surlignés sont à confirmer avec les informations du projet.",
    todo: 'À confirmer',
    eyebrow: 'Blogue · Scan-to-BIM',
    h1: "Scan 3D d'un bâtiment existant : du nuage de points aux plans tels que construits et au modèle BIM",
