---
// Static form for the prototype (no backend). Submitting shows a notice instead of sending anything.
interface Field { name: string; label: string; type?: 'text' | 'email' | 'tel' | 'textarea' | 'select'; required?: boolean; autocomplete?: string; half?: boolean; options?: string[]; placeholder?: string }
interface Group { legend: string; name: string; options: string[] }
interface Props { id: string; fields: Field[]; groups?: Group[]; submit: string; notice: string; requiredNote: string }
const { id, fields, groups = [], submit, notice, requiredNote } = Astro.props;
---
<form class="form" id={id} data-static-form novalidate>
  <p class="t-small t-muted form__req">{requiredNote}</p>
  <div class="form__grid">
    {fields.map((f) => (
      <div class:list={['field', { 'field--half': f.half }]}>
        <label for={`${id}-${f.name}`}>{f.label}{f.required && <span aria-hidden="true"> *</span>}</label>
        {f.type === 'textarea'
          ? <textarea id={`${id}-${f.name}`} name={f.name} rows="5" required={f.required}></textarea>
          : f.type === 'select'
          ? <div class="field__select">
              <select class="ps-select" id={`${id}-${f.name}`} name={f.name} required={f.required}>
                <option class="ps-select__placeholder" value="" disabled selected>{f.placeholder}</option>
                {f.options?.map((o) => <option value={o}>{o}</option>)}
              </select>
              <svg width="12" height="8" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
            </div>
          : <input id={`${id}-${f.name}`} name={f.name} type={f.type ?? 'text'} required={f.required} autocomplete={f.autocomplete} />}
      </div>
    ))}
  </div>
  {groups.map((g) => (
    <fieldset class="checks">
      <legend>{g.legend}</legend>
      <div class="checks__grid">
        {g.options.map((o, i) => (
          <label class="check"><input type="checkbox" name={g.name} value={o} id={`${id}-${g.name}-${i}`} /><span>{o}</span></label>
        ))}
      </div>
    </fieldset>
  ))}
  <button class="btn btn--primary" type="submit">{submit}<span class="btn__arrow" aria-hidden="true">→</span></button>
  <p class="form__notice t-small" role="status" hidden>{notice}</p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-static-form]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const n = form.querySelector<HTMLElement>('.form__notice');
      if (n) n.hidden = false;
    });
  });
</script>

<style>
  .form { display: grid; gap: var(--sp-5); }
  .form__req { margin: 0; }
  .form__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-5); }
  .field { grid-column: span 2; display: flex; flex-direction: column; gap: 8px; }
  .field--half { grid-column: span 1; }
  label, legend { font-size: var(--fs-small); font-weight: 500; }
  input[type='text'], input[type='email'], input[type='tel'], textarea, select {
    width: 100%; padding: 14px 16px; border: 1px solid rgb(0 66 37 / 0.35); border-radius: var(--radius-card);
    background: #fff; color: var(--ps-green-900); font: 400 1rem/1.4 var(--font);
  }
  /* Description: vertical resize only, bounded; grows with its content where supported */
  textarea { display: block; max-width: 100%; resize: vertical; min-height: 9.5rem; max-height: 28rem; field-sizing: content; }
  @supports (field-sizing: content) { textarea { resize: none; } } /* auto-grow replaces the drag handle */
  input:focus-visible, textarea:focus-visible, select:focus-visible { outline: 3px solid var(--ps-gold); outline-offset: 1px; border-color: var(--ps-green-900); }
  .field__select { position: relative; display: flex; align-items: center; }
  .field__select select { padding-right: 44px; cursor: pointer; }
  .field__select select:invalid { color: var(--ps-green-600); }
  .field__select svg { position: absolute; right: 16px; pointer-events: none; color: var(--ps-green-900); }
  .checks { border: 0; padding: 0; margin: 0; }
  .checks legend { margin-bottom: 12px; }
  .checks__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 24px; }
  .check { display: flex; gap: 10px; align-items: center; font-weight: 400; cursor: pointer; }
  .check input { width: 18px; height: 18px; accent-color: var(--ps-green-900); }
  .form .btn { justify-self: start; }
  .form__notice { padding: 12px 16px; border-radius: var(--radius-card); background: var(--ps-green-900); color: var(--ps-cream); }
</style>
