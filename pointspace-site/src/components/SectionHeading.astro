---
interface Props { eyebrow?: string; title: string; intro?: string; id?: string; align?: 'left' | 'split'; level?: 2 | 3 }
const { eyebrow, title, intro, id, align = 'left', level = 2 } = Astro.props;
const H = `h${level}` as 'h2' | 'h3';
---
<div class:list={['sh', `sh--${align}`]} data-reveal>
  <div class="sh__head">
    {eyebrow && <p class="eyebrow t-label">{eyebrow}</p>}
    <H id={id} class="t-h2">{title}</H>
  </div>
  {(intro || Astro.slots.has('default')) && <div class="sh__intro t-lead t-muted">{intro}<slot /></div>}
</div>

<style>
  .sh { margin-bottom: var(--sp-8); }
  .sh__head :is(h2, h3) { max-width: 20ch; }
  .sh--left .sh__intro { margin-top: var(--sp-5); max-width: 60ch; }
  .sh--split { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-8); align-items: end; }
  .sh--split .sh__intro { max-width: 52ch; justify-self: end; }
</style>
