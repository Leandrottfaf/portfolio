---
// Testimonials are quoted as published on pointspace.ca.
interface Props { quote: string; name: string; role: string; company: string; lang: 'fr' | 'en' }
const { quote, name, role, company, lang } = Astro.props;
const [open, close] = lang === 'fr' ? ['« ', ' »'] : ['“', '”'];
---
<figure class="quote" data-reveal>
  <blockquote class="quote__text">{open}{quote}{close}</blockquote>
  <figcaption class="quote__by t-small">
    <strong>{name}</strong><span>{role}, {company}</span>
  </figcaption>
</figure>

<style>
  .quote { margin: 0; display: flex; flex-direction: column; gap: var(--sp-5); }
  .quote__text { margin: 0; font-size: 1.75rem; line-height: 1.3; font-weight: 300; letter-spacing: -0.01em; }
  .quote__by { display: flex; flex-direction: column; gap: 2px; color: var(--fg-muted); padding-left: 20px; border-left: 3px solid var(--ps-gold); }
  .quote__by strong { font-weight: 500; color: inherit; }
  .theme-cream .quote__by strong, .theme-cream-50 .quote__by strong { color: var(--ps-green-900); }
  .theme-green .quote__by strong, .theme-green-700 .quote__by strong { color: var(--ps-cream); }
</style>
