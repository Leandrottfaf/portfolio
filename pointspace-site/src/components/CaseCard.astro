---
import Picture from './Picture.astro';
import { ROUTES, type Lang } from '../data/routes';
import { UI } from '../data/ui';
import { serviceById } from '../data/services';
import type { CaseStudy } from '../data/caseStudies';
interface Props { cs: CaseStudy; lang: Lang; size?: 'lg' | 'md' }
const { cs, lang, size = 'md' } = Astro.props;
const t = UI[lang];
const internal = cs.route ? ROUTES[cs.route][lang] : undefined;
const href = internal ?? cs[lang].live;
---
<article class:list={['case is-card', `case--${size}`]} data-reveal>
  {cs.image ? <Picture name={cs.image} lang={lang} ratio={size === 'lg' ? '16/10' : '3/2'} sizes="(min-width: 1280px) 33vw, 50vw" class="case__media zoom" /> : (
    <div class="case__ph" style={`aspect-ratio:${size === 'lg' ? '16/10' : '3/2'}`} aria-hidden="true">
      <span class="case__ph-bars">{Array.from({ length: 9 }, (_, i) => <span style={`--h:${20 + i * 9}%`}></span>)}</span>
      <span class="case__ph-name">{cs.client}</span>
    </div>
  )}
  <div class="case__body">
    <p class="case__client t-label">{cs.client}</p>
    <h3 class="case__title t-h4"><a href={href} class="case__link card-link">{cs[lang].title}</a></h3>
    <ul class="chips case__chips">
      {cs.services.slice(0, 3).map((id) => <li class="chip">{serviceById(id)[lang].label}</li>)}
    </ul>
    <span class="case__cta t-small">
      {t.readCase}{internal ? <> <span class="go" aria-hidden="true">→</span></> : <><span class="case__ext"> {t.liveLink} </span><span class="go go--ext" aria-hidden="true">↗</span></>}
    </span>
  </div>
</article>

<style>
  .case { position: relative; display: flex; flex-direction: column; gap: 0; }
  .case__body { padding-top: var(--sp-5); display: flex; flex-direction: column; gap: 12px; }
  .case__client { color: var(--fg-muted); }
  .case__title { font-size: 1.375rem; line-height: 1.25; font-weight: 400; }
  .case--lg .case__title { font-size: 1.75rem; }
  .case__link { text-decoration: none; }
  .case__link::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .case:hover .case__link { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  .case__chips { margin-top: 4px; }
  .case__cta { font-weight: 500; }
  .case__ext { font-weight: 400; color: var(--fg-muted); }
  .case__ph { transition: background var(--dur) var(--ease); position: relative; display: flex; align-items: flex-end; justify-content: space-between; padding: 24px; border-radius: var(--radius-media); background: var(--ps-green-900); color: var(--ps-cream); overflow: hidden; }
  .case__ph-bars { display: flex; align-items: flex-end; gap: 8px; height: 60%; }
  .case__ph-bars span { width: 3px; height: var(--h); background: rgb(237 231 218 / 0.4); border-radius: 2px 2px 0 0; }
  .case__ph-bars span:nth-child(n+7) { background: var(--ps-gold); }
  .case__ph-name { font-size: 1.25rem; font-weight: 300; text-align: right; max-width: 60%; }
  .case:hover .case__ph { background: var(--ps-green-700); }
</style>
